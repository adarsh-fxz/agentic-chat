DJANGO_ENV=local
DJANGO_DEBUG=true
DJANGO_SECRET_KEY=secret
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

DATABASE_URL=postgres://agentic_chat:agentic_chat@postgres:5432/agentic_chat
REDIS_URL=redis://redis:6379/0
CACHE_URL=redis://redis:6379/1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
AGENT_TOOL_TIMEOUT_SECONDS=5
AGENT_TOOLS_USE_CELERY=true
AGENT_RUN_STALE_AFTER_MINUTES=10
CELERY_TASK_ALWAYS_EAGER=false

DJANGO_LOG_LEVEL=INFO
DJANGO_LOG_FORMAT=json
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.0
SENTRY_SEND_DEFAULT_PII=false
SENTRY_LOG_LEVEL=20
SENTRY_EVENT_LEVEL=40
DD_SERVICE=agentic-chat
DD_ENV=local
DD_VERSION=local
DD_TRACE_ENABLED=false
DD_LOGS_INJECTION=true
